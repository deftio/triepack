# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Matches .clang-format (ColumnLimit and IndentWidth).
[*.{c,h,cpp,hpp}]
indent_size = 4
max_line_length = 100

[*.{js,ts,json,yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 88

[*.go]
indent_style = tab

[*.{rs,swift,java,kt,kts}]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{cmake,txt}]
indent_size = 4
